# =============================================================================
# Ambientes Virtuais e Gerenciadores (Python & UV)
# =============================================================================
.venv/
venv/
venv*/               # Bloqueia venv312, venv310, etc.
.python-version      # Se você usar o pyenv, mas com UV costuma ser opcional
.uv/                 # Cache interno do gerenciador UV

# =============================================================================
# Cache e Binários (Python & Compilação)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/         # Linter moderno muito usado com FastAPI

# =============================================================================
# Arquivos de Ambiente e Segurança (CRÍTICO)
# =============================================================================
.env
.env.*
!.env.example        # Permite versionar apenas o modelo (sem senhas)
*.pem
*.key
*.pub
/secrets/
.netrc

# =============================================================================
# Configurações de IDE e SO
# =============================================================================
.vscode/
.idea/
.databricks/
databricks.yml
.DS_Store
Thumbs.db

# =============================================================================
# Dados Locais e Bancos (Docker/Data Engineering)
# =============================================================================
# Ignora volumes de dados do Docker para não subir o DB inteiro pro Git
/minio/data*/
/redis/data*/
/postgres/data*/
*.db
*.sqlite
*.log

# =============================================================================
# Exclusões Específicas do Projeto (Engenharia de Dados)
# =============================================================================
# Airflow
/airflow/logs/
/airflow/plugins/
/airflow/config/
/airflow/dags/configconnections_loader.py
/airflow/dags/iceberg*.py

# Spark & Databricks
/spark/jobs/notebooks/
/spark/devapplication/raw_layer_extract_scripts/configconnections_loader.py
/spark/devapplication/sharedmodules/
# Removido /spark/requirements.txt (geralmente é bom versionar o principal)

# Temporários de estudo
*_old/
*_teste/
*_dev/
*_old.py
*_teste.py