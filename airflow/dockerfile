FROM apache/airflow:2.8.3-python3.10

USER root

# Instalação de pacotes necessários
RUN apt-get update && \
    apt-get install -y \
        default-jdk \
        krb5-user \
        krb5-config \
        sudo \
        wget \
        && \
    apt-get clean

# Cria o usuário spark e adiciona ao grupo sudo
RUN useradd -m -s /bin/bash spark && \
    echo 'spark ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/spark

# Criação do usuário airflow com senha e permissão de root
RUN echo 'airflow:airflow' | chpasswd && \
    usermod -aG sudo airflow

# Download e instalação do Apache Spark 3.4.3
RUN wget https://dlcdn.apache.org/spark/spark-3.4.3/spark-3.4.3-bin-hadoop3.tgz -O /tmp/spark-3.4.3-bin-hadoop3.tgz && \
    tar -xvzf /tmp/spark-3.4.3-bin-hadoop3.tgz -C /opt/ && \
    mv /opt/spark-3.4.3-bin-hadoop3 /opt/spark && \
    rm /tmp/spark-3.4.3-bin-hadoop3.tgz

USER airflow

# Upgrade do pip para a versão mais recente
RUN python -m pip install --upgrade pip

# Instalação dos pacotes Python para Hadoop e Spark
RUN pip install pyspark hdfs

# Copia do arquivo requirements.txt para o container e instalação dos pacotes do Airflow
COPY --chown=airflow:airflow ./requirements.txt /requirements.txt
RUN pip install -r /requirements.txt

# Configuração do Airflow
ENV AIRFLOW_HOME=/opt/airflow

COPY airflow.cfg ${AIRFLOW_HOME}/airflow.cfg

# Configurações do Hadoop e Spark
COPY --chown=airflow:airflow ./hadoop /opt/hadoop
COPY --chown=airflow:airflow ./spark /opt/spark

# Adicionando variáveis de ambiente do Hadoop e Spark
ENV HADOOP_HOME=/opt/hadoop
ENV SPARK_HOME=/opt/spark
ENV PATH=$HADOOP_HOME/bin:$SPARK_HOME/bin:$PATH

# Inicializando o Airflow
ENTRYPOINT [ "airflow" ]
CMD ["standalone"]
