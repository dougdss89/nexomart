# Utilizando a imagem do Astronomer Runtime
FROM quay.io/astronomer/astro-runtime:10.4.0

USER root

# 1. Instalação de dependências do sistema (se houver packages.txt, o Astro instala sozinho)
# Aqui mantemos a criação do usuário spark conforme sua necessidade
RUN useradd -m -s /bin/bash spark && \
    echo 'spark ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/spark

# 2. Configurações de ambiente para Spark/Hadoop
ENV HADOOP_CONF_DIR=/dockervol/hadoop/etc/hadoop
ENV HADOOP_HOME=/dockervol/hadoop
ENV SPARK_HOME=/dockervol/spark
ENV SPARK_CONF_DIR=/dockervol/spark/conf

# 3. Voltar para o usuário astro para operações de Python e arquivos
USER astro

# Upgrade pip
RUN python -m pip install --upgrade pip

# Em vez de instalar manualmente, o ideal é que 'pyspark' e 'hdfs' 
# estejam dentro do seu arquivo requirements.txt local.
# O Astronomer Runtime instalará o requirements.txt automaticamente devido ao ONBUILD.
# Se preferir manter aqui:
RUN pip install --no-cache-dir pyspark hdfs

# 4. Copiar configurações
# Nota: O Astro já define AIRFLOW_HOME como /usr/local/airflow
COPY --chown=astro:astro airflow.cfg ${AIRFLOW_HOME}/airflow.cfg

# O ENTRYPOINT e CMD são gerenciados pelo Astronomer, 
# mas seu docker-compose está sobrescrevendo com 'airflow standalone'