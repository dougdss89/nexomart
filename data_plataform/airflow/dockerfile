FROM quay.io/astronomer/astro-runtime:11.4.0-python-3.12

USER root

# Debian 11 (bullseye) is EOL: deb.debian.org/debian-security no longer serves its packages (404).
# Switch apt to the snapshot.debian.org entries that the base image already ships commented out
# (pinned to 2024-05-13). The ONBUILD hook that reads packages.txt is skipped because the file is
# empty, so the packages it used to hold are installed here instead.
RUN sed -i -e 's|^deb |#deb |' -e 's|^# deb http://snapshot|deb http://snapshot|' /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      default-jdk krb5-user krb5-config sudo wget vim net-tools iputils-ping \
      openjdk-17-jre-headless \
      curl \
      tar && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -s /bin/bash spark && \
    echo 'spark ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/spark

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV SPARK_VERSION=3.5.8
ENV SPARK_HOME=/opt/spark
ENV PATH=$SPARK_HOME/bin:$SPARK_HOME/sbin:$PATH

RUN curl -fSL https://dlcdn.apache.org/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3-scala2.13.tgz -o spark.tgz \
    && mkdir -p /opt/spark \
    && tar -xzf spark.tgz -C /opt/spark --strip-components 1 \
    && rm spark.tgz \
    && chown -R astro:astro /opt/spark

USER astro

RUN pip install --no-cache-dir --upgrade pip -r requirements.txt
RUN pip install --no-cache-dir "trino>=0.321.0" "dbt-core>=1.9.0" "dbt-trino>=1.9.0"

# uv roda os seeders do dbapi numa venv isolada (ver /dockervol montado no worker),
# sem tocar no site-packages do Airflow — dbapi usa SQLAlchemy 2.x async, incompatível
# com o SQLAlchemy que o Airflow 2.9 pina internamente.
RUN pip install --no-cache-dir uv

COPY --chown=astro:astro airflow.cfg ${AIRFLOW_HOME}/airflow.cfg
