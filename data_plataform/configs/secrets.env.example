# Copie para secrets.env e preencha os valores reais.
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# Buckets extras provisionados automaticamente pelo serviço minio-init (minio/docker-compose.yml)
# a cada `make up`/`make up-minio` — lista separada por vírgula, sem espaços. "spark-events" já é
# criado à parte (obrigatório para o Spark History Server) e não precisa estar aqui. Para adicionar
# um bucket novo (ex: um pipeline/camada que grava em s3a://um-bucket-novo/), só acrescentar o nome.
MINIO_EXTRA_BUCKETS=landing,bronze,silver,iceberg,deltadw

POSTGRES_USER=your-pg-user
POSTGRES_PASSWORD=your-pg-password
POSTGRES_DB=your-pg-db
POSTGRES_HOST=pgprojeto
POSTGRES_PORT=5432
POSTGRES_GOLD_DB=golddw
PG_SHARED_BUFFERS=1536MB
# Ver configs/postgresql/README.md para o racional de cada valor abaixo.
PG_WORK_MEM=128MB
PG_MAINTENANCE_WORK_MEM=1GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_MAX_WAL_SIZE=16GB
PG_CHECKPOINT_COMPLETION_TARGET=0.9
PG_WAL_COMPRESSION=on
PG_SYNCHRONOUS_COMMIT=off
# fsync/full_page_writes off = risco de corrupção de página num crash de SO/hardware.
# Só aceitável com dados sintéticos/regeneráveis — ver README antes de copiar.
PG_FSYNC=off
PG_FULL_PAGE_WRITES=off
# I/O tuning para storage SSD/VM (não HDD, que é o default do Postgres) — ver
# docs/SEEDER_MICROBATCHING.md antes de copiar valores diferentes.
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_MAINTENANCE_IO_CONCURRENCY=200
PG_RANDOM_PAGE_COST=1.1

# Trino (usado pelo profiles.yml do dbt)
TRINO_HOST=trino-coordinator
TRINO_PORT=8080
TRINO_CATALOG=nexo
TRINO_SCHEMA=gold

# Bancos dedicados por serviço, todos no mesmo Postgres (POSTGRES_HOST/PORT acima)
POSTGRES_AIRFLOW_DB=airflowdb
POSTGRES_NESSIE_DB=nessiedb
POSTGRES_UC_DB=unitycatalogdb

# MinIO (endpoint completo, referenciado por Nessie, Unity Catalog, Trino e Spark)
MINIO_ENDPOINT=http://minio:9000

# Hive Metastore (referenciado pelos catálogos Iceberg do Trino e do Spark)
HIVE_METASTORE_URI=thrift://hive-metastore:9083

AIRFLOW_ADMIN_PASSWORD=your-airflow-password

# Celery worker concurrency (default do Airflow é 8 se omitido)
AIRFLOW_WORKER_CONCURRENCY=8

# Paths usados pelos nexomart_*_dag.py para montar o comando `uv run` dentro do airflow-worker
SEEDER_ROOT=/dockervol/dbapi/api/seeder
UV_PROJECT=/dockervol

REDIS_PASSWORD=your-redis-password

# Spark worker — sizing por réplica (spark/docker-compose.yml). Dimensionado para caber
# 3 réplicas (docker compose -f spark/docker-compose.yml up -d --scale spark-worker=3)
# dentro de um budget de 24 cores / 54GB Docker: 3 × (4 cores / 10GB) = 12 cores / 30GB,
# sobrando espaço para o resto da stack. SPARK_WORKER_MEMORY é o heap da JVM do Spark;
# SPARK_WORKER_MEM_LIMIT é o teto do cgroup do Docker (maior que o heap de propósito,
# pra dar espaço a overhead off-heap).
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=8G
SPARK_WORKER_MEM_LIMIT=10g
