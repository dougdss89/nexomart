# --- Configuração Básica ---
spark.master                     spark://spark-master:7077
spark.eventLog.enabled           true
spark.eventLog.dir               s3a://spark-events/apps
spark.history.ui.port            18080
spark.history.fs.logDirectory    s3a://spark-events/apps
spark.jars.ivy /home/spark/.ivy2

# --- SQL e Warehouse ---
spark.sql.parquet.compression.codec snappy
spark.sql.execution.arrow.pyspark.enabled true
spark.sql.catalogImplementation      hive
spark.sql.warehouse.dir              s3a://deltadw/warehouse/

# --- Recursos ---
spark.sql.shuffle.partitions     32
spark.default.parallelism        32
spark.executor.memory            8g
spark.driver.memory              4g
spark.executor.cores             4
spark.driver.cores               2
spark.executor.memoryOverhead    2g
spark.cores.max                  8

# --- JVM Options ---
spark.executor.extraJavaOptions  -XX:+UseG1GC -XX:+UseStringDeduplication -XX:InitiatingHeapOccupancyPercent=35 -Dlog4j.configuration=file:/opt/spark/conf/log4j.properties -Daws.java.v1.disableDeprecationAnnouncement=true
spark.driver.extraJavaOptions    -XX:+UseG1GC -XX:+UseStringDeduplication -XX:InitiatingHeapOccupancyPercent=35 -Dlog4j.configuration=file:/opt/spark/conf/log4j.properties -Daws.java.v1.disableDeprecationAnnouncement=true

# --- MinIO (S3A) ---
spark.hadoop.fs.s3a.impl         org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.endpoint     ${MINIO_ENDPOINT}
spark.hadoop.fs.s3a.access.key   ${MINIO_ACCESS_KEY}
spark.hadoop.fs.s3a.secret.key   ${MINIO_SECRET_KEY}
spark.hadoop.fs.s3a.path.style.access true
spark.hadoop.fs.s3a.connection.ssl.enabled false

# --- Extensões SQL ---
spark.sql.extensions             io.delta.sql.DeltaSparkSessionExtension,org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions

# --- DELTA (default catalog) ---
# spark_catalog is the default catalog used by unqualified table references.
# DeltaCatalog wraps the built-in Hive catalog, adding Delta Lake support.
spark.sql.catalog.spark_catalog           org.apache.spark.sql.delta.catalog.DeltaCatalog
spark.sql.catalog.spark_catalog.warehouse s3a://deltadw/
spark.hadoop.hive.metastore.uris          ${HIVE_METASTORE_URI}

# --- NEXO (Iceberg REST Catalog via Unity Catalog OSS) ---
# Catálogo oficial da plataforma — gerenciado pelo Unity Catalog OSS.
# Use para LEITURA: spark.table("nexo.<schema>.<table>") / USE CATALOG nexo.
# Para ESCRITA use o catálogo iceberglake (HadoopCatalog) e registre via UC REST API.
# Schemas disponíveis: bronze | silver | gold | product | sales | purchasing | ...
spark.sql.catalog.nexo                    org.apache.iceberg.spark.SparkCatalog
spark.sql.catalog.nexo.catalog-impl       org.apache.iceberg.rest.RESTCatalog
spark.sql.catalog.nexo.uri                ${UNITYCATALOG_REST_URI}
spark.sql.catalog.nexo.token              not-used
spark.sql.catalog.nexo.warehouse          unity
spark.sql.catalog.nexo.format-version     3
# HadoopFileIO reusa credenciais S3A já configuradas (evita conflito AWS SDK v1/v2 com MinIO)
spark.sql.catalog.nexo.io-impl            org.apache.iceberg.hadoop.HadoopFileIO

# --- ICEBERGLAKE (IcebergHiveCatalog — escrita Iceberg via Hive Metastore) ---
# Catálogo Iceberg que usa Hive Metastore para registrar tabelas.
# Spark escreve aqui → Trino lê via connector iceberg + hive metastore (iceberglake catalog).
# Coexiste com spark_catalog (Delta) porque usa databases distintos no Hive Metastore.
spark.sql.catalog.iceberglake                            org.apache.iceberg.spark.SparkCatalog
spark.sql.catalog.iceberglake.catalog-impl               org.apache.iceberg.hive.HiveCatalog
spark.sql.catalog.iceberglake.uri                        ${HIVE_METASTORE_URI}
spark.sql.catalog.iceberglake.warehouse                  s3a://deltadw/iceberglake
spark.sql.catalog.iceberglake.io-impl                    org.apache.iceberg.hadoop.HadoopFileIO
# HMS standalone não tem tabelas ACID (TXN_COMPONENTS etc.) — locking via Thrift falha.
# Pipeline tem escritor único (Airflow sequencial), locking desnecessário.
spark.sql.catalog.iceberglake.hive.lock-enabled          false

# --- Adaptive Query Execution ---
spark.sql.adaptive.enabled true
spark.sql.adaptive.coalescePartitions.enabled true
spark.sql.adaptive.skewJoin.enabled true
spark.sql.adaptive.localShuffleReader.enabled true

# --- Delta write tuning ---
spark.sql.catalog.spark_catalog.write.target-file-size-bytes 536870912

# --- S3A performance ---
spark.hadoop.fs.s3a.connection.timeout 120000
spark.hadoop.fs.s3a.connection.establish.timeout 60000
spark.hadoop.fs.s3a.threads.max 200
spark.hadoop.fs.s3a.connection.maximum 200
spark.hadoop.fs.s3a.fast.upload true
spark.hadoop.fs.s3a.multipart.size 134217728
spark.hadoop.fs.s3a.multipart.threshold 134217728
spark.hadoop.fs.s3a.attempts.maximum 10


# --- DataFlint Spark UI (JAR baked into image via Dockerfile) ---
# Live UI (job em execução): http://localhost:4040/dataflint  (porta do driver no airflow_worker)
# History UI (job concluído): http://localhost:18080 → abra a app → aba "DataFlint"
# Standard plan view: http://localhost:18080 → app → aba "SQL / DataFrame"
spark.plugins                                          io.dataflint.spark.SparkDataflintPlugin
spark.sql.maxMetadataStringLength                      1000

# Iceberg: descobre todos os catálogos automaticamente (nexo)
spark.dataflint.iceberg.autoCatalogDiscovery           true

# Delta Lake: coleta metadados e detecta Z-Order
spark.dataflint.instrument.deltalake.enabled           true
spark.dataflint.instrument.deltalake.collectZindexFields true

# Spark operations instrumentation (window functions, pandas UDFs)
spark.dataflint.instrument.spark.enabled               true
spark.dataflint.instrument.spark.window.enabled        true
spark.dataflint.instrument.spark.mapInPandas.enabled   true

# Telemetria anônima desabilitada para ambiente local
spark.dataflint.telemetry.enabled                      false

# --- Packages (Spark 3.5 / Scala 2.13) ---
# delta-spark       : Delta Lake core
# hadoop-aws        : S3A FileSystem
# unitycatalog-spark: Unity Catalog OSS Spark connector
# iceberg           : Iceberg REST catalog (nexo)
# postgresql        : JDBC driver
# dataflint         : JAR já em $SPARK_HOME/jars/ via Dockerfile — não listar aqui
spark.jars.packages  io.delta:delta-spark_2.13:3.2.1,org.apache.hadoop:hadoop-aws:3.3.4,org.apache.iceberg:iceberg-spark-runtime-3.5_2.13:1.7.1,org.postgresql:postgresql:42.7.5,com.microsoft.sqlserver:mssql-jdbc:12.8.1.jre11,io.dataflint:spark_2.13:0.9.9
