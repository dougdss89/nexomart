# --- Configuração Básica ---
spark.master                     spark://spark-master:7077
spark.eventLog.enabled           true
spark.eventLog.dir               /opt/spark/spark-events
spark.history.ui.port            18080
spark.history.fs.logDirectory    file:/opt/spark/spark-events
spark.jars.ivy /home/spark/.ivy2

# --- SQL e Warehouse ---
spark.sql.parquet.compression.codec snappy
spark.sql.execution.arrow.pyspark.enabled true

# --- Recursos ---
spark.sql.shuffle.partitions     32
spark.default.parallelism        32
spark.executor.memory            8g
spark.driver.memory              4g
spark.executor.cores             4
spark.driver.cores               2
spark.executor.memoryOverhead    2g
spark.cores.max                  8

# --- JVM Options ---
spark.executor.extraJavaOptions  -XX:+UseG1GC -XX:+UseStringDeduplication -XX:InitiatingHeapOccupancyPercent=35 -Dlog4j.configuration=file:/opt/spark/conf/log4j.properties -Daws.java.v1.disableDeprecationAnnouncement=true
spark.driver.extraJavaOptions    -XX:+UseG1GC -XX:+UseStringDeduplication -XX:InitiatingHeapOccupancyPercent=35 -Dlog4j.configuration=file:/opt/spark/conf/log4j.properties -Daws.java.v1.disableDeprecationAnnouncement=true

# --- MinIO (S3A) ---
spark.hadoop.fs.s3a.impl         org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.endpoint     http://minio:9000
spark.hadoop.fs.s3a.access.key   ${MINIO_ACCESS_KEY}
spark.hadoop.fs.s3a.secret.key   ${MINIO_SECRET_KEY}
spark.hadoop.fs.s3a.path.style.access true
spark.hadoop.fs.s3a.connection.ssl.enabled false

# --- Extensões SQL ---
spark.sql.extensions             io.delta.sql.DeltaSparkSessionExtension,org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions

# --- DELTA (default catalog) ---
# spark_catalog is the default catalog used by unqualified table references.
# DeltaCatalog wraps the built-in Hive catalog, adding Delta Lake support.
spark.sql.catalog.spark_catalog           org.apache.spark.sql.delta.catalog.DeltaCatalog
spark.sql.catalog.spark_catalog.warehouse s3a://deltadw/

# --- UNITY CATALOG OSS ---
# "unity" catalog: governed namespace for Delta tables with ACL, lineage and discovery.
# Use: spark.table("unity.<schema>.<table>") or USE CATALOG unity.
spark.sql.catalog.unity                   io.unitycatalog.connectors.spark.UCSingleCatalog
spark.sql.catalog.unity.uri               http://unitycatalog:8080
spark.sql.catalog.unity.token             not-used

# --- NEXO (Iceberg REST Catalog via Unity Catalog OSS) ---
# Catálogo Iceberg nativo gerenciado pelo Unity Catalog OSS.
# Use: spark.table("nexo.<schema>.<table>") ou USE CATALOG nexo.
# Format v3 habilitado por padrão (deletion vectors, row lineage).
spark.sql.catalog.nexo                    org.apache.iceberg.spark.SparkCatalog
spark.sql.catalog.nexo.catalog-impl       org.apache.iceberg.rest.RESTCatalog
spark.sql.catalog.nexo.uri                http://unitycatalog:8080/api/2.1/unity-catalog/iceberg
spark.sql.catalog.nexo.token              not-used
spark.sql.catalog.nexo.warehouse          main
spark.sql.catalog.nexo.format-version     3

# --- Adaptive Query Execution ---
spark.sql.adaptive.enabled true
spark.sql.adaptive.coalescePartitions.enabled true
spark.sql.adaptive.skewJoin.enabled true
spark.sql.adaptive.localShuffleReader.enabled true

# --- Delta write tuning ---
spark.sql.catalog.spark_catalog.write.target-file-size-bytes 536870912

# --- S3A performance ---
spark.hadoop.fs.s3a.connection.timeout 120000
spark.hadoop.fs.s3a.connection.establish.timeout 60000
spark.hadoop.fs.s3a.threads.max 200
spark.hadoop.fs.s3a.connection.maximum 200
spark.hadoop.fs.s3a.fast.upload true
spark.hadoop.fs.s3a.multipart.size 134217728
spark.hadoop.fs.s3a.multipart.threshold 134217728
spark.hadoop.fs.s3a.attempts.maximum 10

# Otimização de Committer: evita renomear arquivos temporários no S3
spark.sql.sources.commitProtocolClass org.apache.spark.internal.io.cloud.PathOutputCommitProtocol
spark.hadoop.mapreduce.fileoutputcommitter.algorithm.version 2
spark.hadoop.mapreduce.fileoutputcommitter.cleanup-failures.ignored true

# --- Packages (Spark 3.5 / Scala 2.13) ---
# delta-spark       : Delta Lake core
# hadoop-aws        : S3A FileSystem
# unitycatalog-spark: Unity Catalog OSS Spark connector
# postgresql        : JDBC driver
spark.jars.packages  io.delta:delta-spark_2.13:3.2.1,org.apache.hadoop:hadoop-aws:3.3.4,io.unitycatalog:unitycatalog-spark-3.5_2.13:0.3.0,org.apache.iceberg:iceberg-spark-runtime-3.5_2.13:1.7.1,org.postgresql:postgresql:42.7.5,com.microsoft.sqlserver:mssql-jdbc:12.8.1.jre11
