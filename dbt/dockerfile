# Use uma imagem Python oficial como base
FROM python:3.9-slim

# Define variáveis de ambiente
ENV DBT_PROFILES_DIR=/root/.dbt
ENV VIRTUAL_ENV=/opt/venv

# Cria e ativa o ambiente virtual
RUN python -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Instala as dependências necessárias
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    ssh-client \
    software-properties-common \
    make \
    build-essential \
    ca-certificates \
    libpq-dev \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Cria o usuário dbt e adiciona ao grupo sudo
RUN useradd -m -s /bin/bash dbt && \
    usermod -aG sudo dbt && \
    echo "dbt ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Define o usuário dbt como proprietário dos diretórios necessários
RUN mkdir -p /usr/app/dbt && \
    mkdir -p /root/.dbt && \
    chown -R dbt:dbt /usr/app/dbt && \
    chown -R dbt:dbt /root/.dbt && \
    chown -R dbt:dbt $VIRTUAL_ENV

# Instala o dbt-core e adaptadores necessários
RUN pip install --no-cache-dir dbt-core dbt-postgres

# Cria diretório para o projeto dbt
WORKDIR /usr/app/dbt

# Copia os arquivos de configuração do dbt
COPY profiles.yml /root/.dbt/
COPY . .

# Ajusta as permissões dos arquivos copiados
RUN chown -R dbt:dbt /usr/app/dbt && \
    chown -R dbt:dbt /root/.dbt

# Script de inicialização
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && \
    chown dbt:dbt /entrypoint.sh

# Muda para o usuário dbt
USER dbt

ENTRYPOINT ["/entrypoint.sh"]